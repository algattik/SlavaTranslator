{
  "name": "slava-russian-dictionary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "npm run release:package",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "test:unit:report": "vitest run --reporter=default --reporter=json --outputFile=artifacts/vitest.json",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:performance": "SLAVA_ENFORCE_PERFORMANCE=1 npm run build && playwright test -g \"100,000-character page\"",
    "test:e2e:report": "PLAYWRIGHT_JSON_OUTPUT_FILE=artifacts/playwright.json playwright test --reporter=json",
    "test:e2e:packaged": "npm run release:package && npm run prepare:packaged-smoke && PLAYWRIGHT_JSON_OUTPUT_FILE=artifacts/playwright-packaged.json SLAVA_EXTENSION_PATH=.output/packaged-smoke playwright test --reporter=json -g \"packaged smoke\"",
    "test:e2e:live": "SLAVA_LIVE_MEDIAWIKI=1 npm run test:e2e",
    "test:e2e:live:report": "mkdir -p artifacts && npm run build && PLAYWRIGHT_JSON_OUTPUT_FILE=artifacts/live-canary.json SLAVA_LIVE_MEDIAWIKI=1 playwright test --reporter=json -g \"live Wiktionary\"",
    "prepare:packaged-smoke": "node tools/prepare-packaged-smoke.mjs",
    "release:sbom": "mkdir -p artifacts && npm sbom --sbom-format cyclonedx > artifacts/sbom.cdx.json",
    "release:package": "npm run build && node tools/package-release.mjs",
    "release:gates": "node tools/run-release-quality-gates.mjs",
    "release:reproduce": "node tools/verify-reproducible-release.mjs",
    "release:evidence": "node tools/verify-provenance.mjs && node tools/build-release-quality-report.mjs",
    "release:verify": "npm run release:package && npm run release:sbom && node tools/verify-release.mjs",
    "fixtures:capture": "node tools/capture-mediawiki-fixtures.mjs",
    "sources:acquire": "node tools/acquire-index-sources.mjs",
    "index:stress": "node tools/build-stress-index.ts",
    "index:morphology": "node --max-old-space-size=8192 tools/build-morphology-index.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "26.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
