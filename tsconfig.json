{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    ".wxt/types",
    "entrypoints/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "*.config.ts"
  ]
}
